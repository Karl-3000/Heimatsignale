# URL der PMTiles-Datei mit der Grundkarte (Protomaps-Basemap, Schema v4).
# Leer lassen: Die Karte zeigt dann nur Hintergrund, 20-km-Kreis und Knoten.
# Muss unter derselben Origin liegen (die CSP erlaubt nur connect-src 'self').
# Beispiel: /kacheln/deutschland.pmtiles, vom Reverse-Proxy ausgeliefert
PUBLIC_TILES_URL=

# Optional: Glyphen für Ortsnamen auf der Grundkarte, z. B. /kacheln/fonts/{fontstack}/{range}.pbf
# Leer lassen: keine Beschriftung auf der Grundkarte, keine externen Anfragen.
PUBLIC_GLYPHS_URL=

# Entwicklungsrouten (/dev/netz mit künstlichen Daten) auch im Produktions-Build freigeben.
# Nur für Prototyp-Tests setzen, sonst leer lassen.
PUBLIC_DEV_ROUTES=
