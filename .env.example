# Heimatsignale: Betriebseinstellungen. Nach .env kopieren, ausfüllen, nie ins Repository legen.

# Domain, unter der der Dienst läuft (Caddy holt dafür automatisch ein TLS-Zertifikat).
SITE_DOMAIN=heimatsignale.example
SITE_URL=https://heimatsignale.example
ALLOWED_HOSTS=heimatsignale.example
SITE_NAME=Heimatsignale

# Langer Zufallswert, z. B. aus:  openssl rand -base64 48
SECRET_KEY=
DB_NAME=heimat
DB_USER=heimat
DB_PASSWORD=

# Pfad des Admin-Bereichs (eigener Pfad, PROJEKT.md Abschnitt 13).
ADMIN_PATH=verwaltung

# Transaktionaler E-Mail-Versand (Anbieter mit AV-Vertrag).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Heimatsignale <noreply@heimatsignale.example>
MODERATION_EMAIL=moderation@heimatsignale.example

# Kartenkacheln als PMTiles (selbst gehostet). Datei nach data/tiles/ legen, dann z. B.:
# PUBLIC_TILES_URL=/tiles/deutschland.pmtiles
# Leer lassen: Die Karte zeigt dann nur Wohnort-Knoten und Umkreis ohne Hintergrundkarte.
PUBLIC_TILES_URL=
PUBLIC_GLYPHS_URL=

DEBUG=0
